# Panel /admin. Genera las tres primeras con: npm run admin:setup
ADMIN_PASSWORD_HASH=
ADMIN_TOTP_SECRET=
ADMIN_SESSION_SECRET=

# Solo producción: el panel guarda en el repo con este token.
# Crea un fine-grained token limitado a este repositorio, con permiso
# "Contents: Read and write". En desarrollo, sin token, guarda en los archivos locales.
GITHUB_TOKEN=
GITHUB_REPO=mikerb95/don-patacon
GITHUB_BRANCH=main
