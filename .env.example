# BCMS — OBLIGATORIAS (sin ellas el build falla con "401: Not logged in")
# Se obtienen en app.thebcms.com → tu proyecto → Settings → API Keys.
# Formato: <keyId>.<secret>.<instanceId>
# BCMS_API_KEY: clave privada, usada en build (bcms pull) y en el servidor.
# PUBLIC_BCMS_API_KEY: clave pública (se expone al navegador, usa una key de solo lectura).
BCMS_API_KEY=
PUBLIC_BCMS_API_KEY=

# Datos del negocio — FALLBACK.
# La fuente primaria es la entry `business-info` en BCMS (ver BCMS-SETUP.md).
# Estas variables solo se usan si esa entry todavía no existe.
PUBLIC_ADDRESS_LINE1=
PUBLIC_ADDRESS_LINE2=
PUBLIC_ADDRESS_CITY=
PUBLIC_ADDRESS_COUNTRY=

PUBLIC_PHONE_DISPLAY="+57 300 123 4567"
PUBLIC_PHONE_E164="+573001234567"

PUBLIC_EMAIL=contacto@donpatacon.com

# Sin '+', sin espacios. Ej: 573001234567
PUBLIC_WHATSAPP_NUMBER=573001234567

PUBLIC_HOURS="Mar–Dom 12:00–22:00"

PUBLIC_INSTAGRAM_URL=https://instagram.com/donpatacon
PUBLIC_FACEBOOK_URL=
PUBLIC_X_URL=

PUBLIC_MAPS_URL=https://www.google.com/maps/place/...
