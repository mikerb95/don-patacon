---
/**
 * Datos estructurados Schema.org (`Restaurant`) para Google: panel del
 * negocio, Maps y resultados locales. Los valores vacíos se omiten.
 *
 * Pendiente cuando haya dominio: `url` e `image` absolutas.
 */
import type { Business } from '../lib/schema';
import { openingHoursSpecification } from '../lib/hours';

interface Props {
    business: Business;
}

const { business } = Astro.props;
const valid = (value: string) => !!value;
const telephone = business.phone.replace(/[^\d+]/g, '');
const openingHours = openingHoursSpecification(business.hours);

const street = [
    business.mallLocation,
    business.address.line1,
    business.address.line2,
]
    .filter(valid)
    .join(', ');

const sameAs = [
    business.social.instagram,
    business.social.facebook,
    business.social.x,
].filter(valid);

const data = {
    '@context': 'https://schema.org',
    '@type': 'Restaurant',
    name: business.name,
    servesCuisine: 'Colombiana',
    ...(telephone && { telephone }),
    ...(valid(business.email) && { email: business.email }),
    address: {
        '@type': 'PostalAddress',
        ...(street && { streetAddress: street }),
        addressLocality: valid(business.address.city)
            ? business.address.city
            : 'Bogotá',
        addressCountry: 'CO',
    },
    containedInPlace: {
        '@type': 'ShoppingCenter',
        name: 'Centro Comercial Plaza Central',
        address: {
            '@type': 'PostalAddress',
            addressLocality: 'Bogotá',
            addressCountry: 'CO',
        },
    },
    ...(business.mapsUrl && { hasMap: business.mapsUrl }),
    ...(openingHours.length > 0 && { openingHoursSpecification: openingHours }),
    ...(sameAs.length > 0 && { sameAs }),
    acceptsReservations: false,
};
---

<script is:inline type="application/ld+json" set:html={JSON.stringify(data)} />
