---
/**
 * Portada: titular y datos para llegar a la izquierda; a la derecha, la escena
 * "del plátano al patacón" (cortar, freír, aplastar, refreír, crunch, plato real).
 *
 * El HTML que sale del servidor es el estado final (plato real, pasos completos),
 * así que sin JavaScript o con movimiento reducido todo se ve completo y quieto.
 * El script fija el estado inicial y lo anima: en escritorio la sección se fija y
 * el scroll recorre la receta; en el celular corre sola al verse y se puede repetir.
 */
import mascota from '../../assets/mascota.svg?raw';
import { rng, rutaCrocante } from '../../lib/crocante';
import OpenStatus from './OpenStatus';
import type { Business } from '../../lib/schema';
import { summarizeHours } from '../../lib/hours';

interface Props {
    title: string;
    description: string;
    /** Foto del plato con que termina la escena. */
    image: string;
    mallLocation: string;
    hours: Business['hours'];
}

const { title, description, image, mallLocation, hours } = Astro.props;
const summary = summarizeHours(hours);

const aura = rutaCrocante(3, { cx: 300, cy: 320, rx: 262, ry: 232, puntos: 60, serrucho: 0.04 });
const disco = rutaCrocante(21, { cx: 300, cy: 336, rx: 150, ry: 100, puntos: 56, serrucho: 0.07 });
const plato = rutaCrocante(5, { cx: 300, cy: 320, rx: 228, ry: 148, puntos: 80, serrucho: 0.035 });

// Migas que saltan con el crunch: forma y destino fijos (semilla).
const r = rng(42);
const migas = Array.from({ length: 16 }, (_, i) => {
    const s = 6 + r() * 9;
    const ang = (i / 16) * Math.PI * 2 + r() * 0.4;
    return {
        d: rutaCrocante(100 + i, { cx: 300, cy: 330, rx: s, ry: s * 0.8, puntos: 7, serrucho: 0.35 }),
        dx: Math.round(Math.cos(ang) * (150 + r() * 110)),
        dy: Math.round(Math.sin(ang) * (110 + r() * 80) - 40),
    };
});

const PASOS = [
    'Cortamos el plátano verde',
    'Lo freímos una vez',
    'Lo aplastamos en la pataconera',
    'Lo freímos otra vez hasta que cruja',
];
---

<section class="portada" aria-labelledby="portada-titulo">
    <div class="portada__hojas" aria-hidden="true">
        <span class="hoja" style="--x:-4%;--y:-6%;--r:-28deg;--s:1.1" data-prof="1.2"><svg><use href="#hoja-platano"></use></svg></span>
        <span class="hoja hoja--biche" style="--x:-5%;--y:80%;--r:-70deg;--s:.7" data-prof=".7"><svg><use href="#hoja-platano"></use></svg></span>
        <span class="hoja" style="--x:90%;--y:-10%;--r:34deg;--s:1.25" data-prof="1.4"><svg><use href="#hoja-platano"></use></svg></span>
        <span class="hoja hoja--biche" style="--x:95%;--y:34%;--r:70deg;--s:.8" data-prof=".9"><svg><use href="#hoja-platano"></use></svg></span>
    </div>

    <div class="portada__texto">
        <h1 id="portada-titulo" class="titular">{title}</h1>
        {description && <p class="portada__bajada">{description}</p>}

        {(mallLocation || summary.length > 0) && (
            <dl class="datos">
                {mallLocation && <div><dt>Dónde</dt><dd>{mallLocation}</dd></div>}
                {summary.length > 0 && (
                    <div><dt>Horario</dt><dd><OpenStatus hours={hours} summary={summary} client:load /></dd></div>
                )}
            </dl>
        )}

        <div class="acciones">
            <a class="btn-sticker btn-sticker--sol" href="#como-llegar">Cómo llegar</a>
            <a class="btn-sticker" href="/carta">Ver la carta</a>
        </div>

        <ol class="pasos" aria-label="Cómo hacemos el patacón">
            {PASOS.map((p) => <li>{p}</li>)}
        </ol>
    </div>

    <div class="portada__escena">
        <p class="globo" aria-live="polite"><span data-globo>Así de crujiente te espera en el 3-48.</span></p>

        <svg class="escena" viewBox="0 0 600 560" aria-hidden="true">
            <path id="e-aura" d={aura} fill="#FFE07A"></path>

            <g id="e-platano">
                <path d="M140 200 C 215 120, 390 110, 462 176 C 470 184, 462 196, 452 192 C 388 156, 240 164, 156 216 C 144 222, 132 210, 140 200 Z" fill="#A8D13B" stroke="#0E3B1F" stroke-width="6" stroke-linejoin="round"></path>
                <path d="M184 186 C 250 142, 360 136, 420 160" fill="none" stroke="#D3EC86" stroke-width="8" stroke-linecap="round"></path>
                <path d="M452 176 L 478 166" stroke="#0E3B1F" stroke-width="10" stroke-linecap="round"></path>
            </g>
            <g id="e-cuchillo">
                <path d="M300 60 L 318 190 C 306 196, 292 192, 286 186 Z" fill="#EEF0E4" stroke="#0E3B1F" stroke-width="5" stroke-linejoin="round"></path>
                <rect x="290" y="16" width="20" height="50" rx="8" fill="#0E3B1F"></rect>
            </g>

            <g id="e-tajada">
                <ellipse cx="300" cy="330" rx="74" ry="32" fill="#7DB82E" stroke="#0E3B1F" stroke-width="6"></ellipse>
                <ellipse id="e-tajada-pulpa" cx="300" cy="326" rx="62" ry="24" fill="#F6EBB5"></ellipse>
            </g>
            <g id="e-burbujas" fill="#FFFDF2" stroke="#0E3B1F" stroke-width="3">
                <circle cx="214" cy="356" r="7"></circle><circle cx="246" cy="380" r="5"></circle><circle cx="380" cy="364" r="8"></circle>
                <circle cx="352" cy="388" r="5"></circle><circle cx="196" cy="320" r="4"></circle><circle cx="404" cy="326" r="5"></circle>
                <circle cx="300" cy="394" r="6"></circle><circle cx="268" cy="300" r="4"></circle>
            </g>

            <g id="e-prensa">
                <rect x="150" y="364" width="300" height="30" rx="12" fill="#C9711A" stroke="#0E3B1F" stroke-width="6"></rect>
                <g id="e-tapa">
                    <rect x="150" y="296" width="300" height="30" rx="12" fill="#E08A2C" stroke="#0E3B1F" stroke-width="6"></rect>
                    <rect x="440" y="302" width="64" height="18" rx="9" fill="#C9711A" stroke="#0E3B1F" stroke-width="5"></rect>
                </g>
            </g>

            <g id="e-patacon">
                <path id="e-disco" d={disco} fill="#F2D27A" stroke="#0E3B1F" stroke-width="6" stroke-linejoin="round"></path>
                <g fill="none" stroke="#C9711A" stroke-width="4" stroke-linecap="round" opacity=".55">
                    <path d="M228 312 C 250 300, 270 302, 286 312"></path><path d="M314 300 C 340 292, 360 298, 372 310"></path>
                    <path d="M246 352 C 270 340, 296 344, 310 356"></path><path d="M330 348 C 350 340, 368 344, 380 354"></path>
                    <path d="M264 378 C 284 372, 300 374, 312 382"></path>
                </g>
            </g>
            <g id="e-migas" fill="#F5B41F" stroke="#0E3B1F" stroke-width="3" stroke-linejoin="round">
                {migas.map((m) => <path d={m.d} data-dx={m.dx} data-dy={m.dy}></path>)}
            </g>
            <text id="e-crunch" x="300" y="200" text-anchor="middle">¡Crunch!</text>

            {image && (
                <g id="e-plato">
                    <clipPath id="clip-plato"><path d={plato}></path></clipPath>
                    <image href={image} x="70" y="170" width="460" height="300" preserveAspectRatio="xMidYMid slice" clip-path="url(#clip-plato)"></image>
                    <path d={plato} fill="none" stroke="#0E3B1F" stroke-width="6" stroke-linejoin="round"></path>
                </g>
            )}
        </svg>

        <div class="mascota" data-mascota aria-hidden="true" set:html={mascota} />
        <p class="pista" aria-hidden="true">Baja y mira cómo lo hacemos</p>
        <button class="repetir" type="button" hidden>Ver otra vez</button>
    </div>
</section>

<!-- Hoja de plátano reutilizable (decoración). -->
<svg width="0" height="0" style="position:absolute" aria-hidden="true">
    <symbol id="hoja-platano" viewBox="0 0 100 240">
        <path d="M50 4 C 92 52, 98 150, 52 236 C 6 150, 10 52, 50 4 Z" fill="currentColor" stroke="#0E3B1F" stroke-width="5" stroke-linejoin="round"></path>
        <g fill="none" stroke="#0E3B1F" stroke-width="3.5" stroke-linecap="round">
            <path d="M50 14 C 52 90, 52 160, 52 228"></path>
            <path d="M51 60 C 64 52, 74 50, 82 52"></path><path d="M51 96 C 66 86, 78 84, 88 88"></path>
            <path d="M51 134 C 66 124, 78 124, 88 128"></path><path d="M52 172 C 64 164, 74 164, 80 168"></path>
            <path d="M51 70 C 38 62, 28 60, 18 64"></path><path d="M51 108 C 36 98, 24 98, 14 104"></path>
            <path d="M52 146 C 38 138, 26 138, 16 144"></path><path d="M52 184 C 42 178, 32 178, 24 182"></path>
        </g>
    </symbol>
</svg>

<script>
    import { iniciarEscena } from './escena';
    iniciarEscena();
</script>

<style>
    .portada {
        position: relative;
        display: grid;
        grid-template-columns: minmax(0, 1.12fr) minmax(0, 1fr);
        align-items: center;
        gap: 2rem;
        max-width: 1320px;
        margin: 0 auto;
        padding: 2.5rem 1.25rem 3rem;
        min-height: 100svh;
    }
    .portada__texto { position: relative; z-index: 2; display: grid; gap: 1.2rem; }
    .titular {
        font-family: Chango, 'Baloo 2', sans-serif;
        font-size: clamp(2.9rem, 1.4rem + 4.2vw, 4.5rem);
        line-height: 0.92;
        text-wrap: balance;
        text-shadow: 0.05em 0.05em 0 #F5B41F;
    }
    .portada__bajada { font-size: 1.3rem; max-width: 36ch; }

    .datos { display: flex; flex-wrap: wrap; gap: 0.75rem 2rem; }
    .datos dt { font-size: 1rem; font-weight: 800; color: #2E8B2E; }
    .datos dd { font-size: 1.2rem; font-weight: 700; }

    .acciones { display: flex; flex-wrap: wrap; gap: 0.9rem; }
    .btn-sticker {
        display: inline-flex; align-items: center; justify-content: center;
        min-height: 56px; padding: 0 1.6rem;
        font-weight: 800; font-size: 1.2rem; white-space: nowrap; text-decoration: none;
        border: 3px solid #0E3B1F; border-radius: 14px; box-shadow: 0 5px 0 #0E3B1F;
        transition: transform 0.12s ease, box-shadow 0.12s ease;
    }
    .btn-sticker:hover { transform: translateY(-2px); box-shadow: 0 7px 0 #0E3B1F; }
    .btn-sticker:active { transform: translateY(4px); box-shadow: 0 1px 0 #0E3B1F; }
    .btn-sticker--sol { background: #F5B41F; }

    .pasos { list-style: none; counter-reset: paso; margin-top: 0.5rem; display: grid; gap: 0.45rem; }
    .pasos li { counter-increment: paso; display: flex; align-items: center; gap: 0.7rem; font-weight: 700; transition: opacity 0.25s ease; }
    .pasos li::before {
        content: counter(paso);
        display: grid; place-items: center; flex: none;
        width: 2rem; height: 2rem; border: 3px solid #0E3B1F; border-radius: 50%;
        background: #F5B41F; font-weight: 800; line-height: 1;
        transition: background-color 0.25s ease, transform 0.25s ease;
    }
    /* Mientras la escena corre, solo el paso actual queda encendido. */
    .pasos.vivo li { opacity: 0.45; }
    .pasos.vivo li::before { background: transparent; }
    .pasos.vivo li.hecho { opacity: 0.8; }
    .pasos.vivo li.hecho::before { background: #A8D13B; }
    .pasos.vivo li.actual { opacity: 1; }
    .pasos.vivo li.actual::before { background: #F5B41F; transform: scale(1.15); }

    .portada__escena { position: relative; z-index: 1; }
    .escena { width: 100%; height: auto; overflow: visible; }
    #e-crunch {
        font-family: Chango, sans-serif; font-size: 64px; fill: #F5B41F;
        stroke: #0E3B1F; stroke-width: 8px; paint-order: stroke; stroke-linejoin: round;
    }
    /* Estado final del servidor: solo el plato real. */
    #e-platano, #e-cuchillo, #e-tajada, #e-burbujas, #e-prensa, #e-patacon, #e-migas, #e-crunch { opacity: 0; }

    .globo {
        position: absolute; z-index: 3; top: 2%; left: 4%; max-width: 62%;
        background: #FFFDF2; border: 3px solid #0E3B1F; border-radius: 22px;
        padding: 0.6rem 1rem; font-weight: 700; line-height: 1.3; box-shadow: 0 5px 0 #0E3B1F;
    }
    .globo::after {
        content: ''; position: absolute; right: 18%; bottom: -14px; width: 22px; height: 22px;
        background: #FFFDF2; border-right: 3px solid #0E3B1F; border-bottom: 3px solid #0E3B1F;
        transform: rotate(45deg);
    }
    .mascota { position: absolute; z-index: 3; right: -2%; bottom: -4%; width: 27%; }
    .mascota :global(svg) { width: 100%; height: auto; display: block; overflow: visible; }
    .pista {
        position: absolute; left: 50%; bottom: -1.5rem; transform: translateX(-50%);
        font-weight: 700; font-size: 1rem; white-space: nowrap; opacity: 0;
    }
    :global(.js-escena) .pista { opacity: 0.75; }
    .repetir {
        position: absolute; left: 0; bottom: -1.25rem; font: inherit; font-weight: 800; cursor: pointer;
        background: #FFFDF2; border: 3px solid #0E3B1F; border-radius: 14px; padding: 0.4rem 0.9rem; min-height: 44px;
        box-shadow: 0 5px 0 #0E3B1F;
    }
    .repetir[hidden] { display: none; }

    /* Hojas: el span lo mueve el cursor (GSAP) y el svg se mece (CSS); así no se pisan. */
    .portada__hojas { position: absolute; inset: 0; pointer-events: none; overflow: clip; z-index: 0; }
    .hoja {
        position: absolute; left: var(--x); top: var(--y);
        width: 120px; height: 288px; color: #2E8B2E;
        rotate: var(--r); scale: var(--s);
    }
    .hoja--biche { color: #A8D13B; }
    .hoja svg { width: 100%; height: 100%; transform-origin: 50% 100%; animation: mecer 6s ease-in-out infinite alternate; }
    .hoja:nth-child(2n) svg { animation-duration: 7.5s; animation-delay: -2s; }
    @keyframes mecer { from { transform: rotate(-4deg); } to { transform: rotate(5deg); } }

    @media (max-width: 900px) {
        .portada { grid-template-columns: minmax(0, 1fr); min-height: 0; padding-top: 0.5rem; }
        .portada__escena { max-width: 520px; width: 100%; margin: 0 auto 1.5rem; }
        .hoja { width: 80px; height: 192px; }
        .hoja:first-child { left: -18%; top: -6%; }
        .pista { display: none; }
    }
    @media (prefers-reduced-motion: reduce) {
        .hoja svg { animation: none; }
        .btn-sticker, .pasos li, .pasos li::before { transition: none; }
    }
</style>
