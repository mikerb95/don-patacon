---
import Footer from '../components/layout/Footer';
import Header from '../components/layout/Header';
import WhatsAppButton from '../components/layout/WhatsAppButton.astro';
import { content as publishedContent, SITE_DESCRIPTION } from '../lib/content';
import type { Docs } from '../lib/schema';
// Fuentes autoalojadas (sin Google Fonts): Baloo 2 para el texto y Chango
// para titulares y precios. Solo el subset latino.
import '@fontsource/baloo-2/latin-500.css';
import '@fontsource/baloo-2/latin-700.css';
import '@fontsource/baloo-2/latin-800.css';
import '@fontsource/chango/latin-400.css';

interface Props {
    title: string;
    /** Meta description de la página; por defecto, la del sitio. */
    description?: string;
    /** Contenido a mostrar; por defecto, el publicado. */
    content?: Docs;
    /** En la vista previa del panel, los enlaces no navegan. */
    preview?: boolean;
    /** Botón flotante de WhatsApp; se apaga donde ya hay un formulario de pedido. */
    whatsappButton?: boolean;
}

const { title, description = SITE_DESCRIPTION, content = publishedContent, preview = false, whatsappButton = true } = Astro.props;
const { business, pages } = content;
const ogImageUrl = '/thumbnail.jpg';
---

<!doctype html>
<html lang="es">
    <head>
        <meta charset="UTF-8" />
        <meta name="description" content={description} />
        <meta name="viewport" content="width=device-width, initial-scale=1" />
        <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
        <meta name="generator" content={Astro.generator} />
        <meta property="og:title" content="Don Patacón" />
        <meta property="og:description" content={description} />
        <meta property="og:locale" content="es_CO" />
        <meta property="og:image" content={ogImageUrl} />
        <meta property="og:image:secure_url" content={ogImageUrl} />
        <meta property="twitter:title" content="Don Patacón" />
        <meta property="twitter:card" content="summary_large_image" />
        <meta property="twitter:image" content={ogImageUrl} />
        <title>{title}</title>
        <slot name="head" />
        {preview && (
            <script is:inline>
                document.addEventListener('click', (event) => {
                    if (event.target.closest('a')) event.preventDefault();
                }, true);
            </script>
        )}
    </head>
    <body class="font-sans font-medium text-lg leading-normal overflow-x-clip bg-pulpa text-monte">
        <a
            href="#main-content"
            class="sr-only focus:not-sr-only focus:fixed focus:top-2 focus:left-2 focus:z-[100] focus:bg-sol focus:text-monte focus:font-extrabold focus:px-4 focus:py-2 focus:rounded-xl focus:border-3 focus:border-monte"
        >
            Saltar al contenido
        </a>
        <div class="overflow-x-clip flex flex-col min-h-screen">
            <Header client:load />
            <main id="main-content" class="flex flex-col flex-1"><slot /></main>
            <Footer business={business} hasTerms={pages.legal.sections.length > 0} />
        </div>
        {whatsappButton && <WhatsAppButton number={business.whatsapp} businessName={business.name} />}
    </body>
</html>

<style is:global>
@tailwind base;
@tailwind components;
@tailwind utilities;

*,
*::before,
*::after {
    @apply box-border m-0 p-0;
}

:focus-visible {
    outline: 3px solid #0e3b1f;
    outline-offset: 3px;
    border-radius: 6px;
}

::selection {
    background: #f5b41f;
    color: #0e3b1f;
}

.homeAmbience--gridItem:nth-of-type(5n + 1) {
    grid-column: span 2 !important;
    grid-row: span 2 !important;
    aspect-ratio: 1.49 !important;
}

.homeAmbience--gridItem:nth-of-type(5n + 3) {
    grid-row: span 2;
}

.homeAmbience--gridItem:nth-of-type(5n + 4) {
    grid-row: span 2;
}

@media (min-width: 1024px) {
    .homeAmbience--gridItem:nth-of-type(5n + 1) {
        grid-row: span 1 !important;
        aspect-ratio: 3.82 !important;
    }
}

.homeSpecials--gridItem:nth-of-type(5n + 1) {
    grid-row: span 2 !important;
}

.homeSpecials--gridItem:nth-of-type(5n + 2) {
    aspect-ratio: 1.49 !important;
}

.homeSpecials--gridItem:nth-of-type(5n + 3) {
    grid-row: span 2 !important;
}

.homeSpecials--gridItem:nth-of-type(5n + 5) {
    grid-column: span 2 !important;
    grid-row: span 2 !important;
}

.homeSpecials--gridItem:nth-of-type(5n + 5) > div {
    justify-content: center !important;
    align-items: center !important;
    text-align: center !important;
}

@media (min-width: 1024px) {
    .homeSpecials--gridItem:nth-of-type(5n + 2) {
        aspect-ratio: 3.82 !important;
    }
}

@media (min-width: 768px) {
    .homeSpecials--gridItem:nth-of-type(5n + 5) {
        grid-row: span 1 !important;
    }
}

.homeTestimonials--swiperPrev .swiper-button-lock,
.homeTestimonials--swiperNext .swiper-button-lock {
    opacity: 0.5 !important;
    display: flex !important;
}

.fade-entered,
.fade-exited {
    transition: opacity 0.3s;
}
.fade-entering,
.fade-exiting {
    opacity: 0;
}

</style>
