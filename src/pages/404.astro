---
import Btn from '../components/Btn';
import Layout from '../layouts/Layout.astro';
---

<Layout title={'Página no encontrada - Don Patacón'}>
    <div class="flex flex-col items-center gap-6 justify-center my-auto min-h-[400px] lg:gap-10">
        <h1 class="font-display text-[clamp(2.4rem,1.8rem+2.6vw,3.8rem)] leading-none text-center text-balance [text-shadow:.05em_.05em_0_#F5B41F]">
            Esta página no existe
        </h1>
        <p class="text-xl text-center">Puede que el enlace esté viejo. La carta y el local siguen donde siempre.</p>
        <Btn
            theme="accent"
            size="lg"
            to="/"
        >
            Volver al inicio
        </Btn>
    </div>
</Layout>
