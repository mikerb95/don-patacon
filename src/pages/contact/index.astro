---
import type { ContactPageEntry, ContactPageEntryMetaItem } from "../../../bcms/types/ts";
import ArchWithStar from "../../components/ArchWithStar";
import ContentManager from "../../components/ContentManager";
import Layout from "../../layouts/Layout.astro";
import Btn from "../../components/Btn";
import { bcmsPrivate } from '../../bcms-private';
import { getBusinessInfo } from '../../config/business';

const contactPageEntry = (await bcmsPrivate.entry.getBySlug(
    'contact',
    'contact-page',
)) as ContactPageEntry;

if (!contactPageEntry) {
    return Astro.rewrite('/404');
}

const contactPageMeta = contactPageEntry.meta.en as ContactPageEntryMetaItem;

const business = await getBusinessInfo();

// Embed de Google Maps sin API key. Apunta al centro comercial (no al local)
// para que funcione aunque el negocio todavía no tenga perfil en Google.
// Con CSP activo hay que permitir https://www.google.com en frame-src.
const mapEmbedUrl = `https://www.google.com/maps?q=${encodeURIComponent(
    'Centro Comercial Plaza Central, Bogotá',
)}&output=embed`;
---

<Layout
    title={`${contactPageMeta.seo?.title || contactPageMeta.title} - DON PATACÓN`}
    description="Cómo llegar a DON PATACÓN en el Centro Comercial Plaza Central, Bogotá: dirección, mapa, teléfono y horario."
>
    <div>
        <section class="pt-[108px] pb-10 overflow-hidden md:pb-20 lg:pt-[218px] lg:pb-[120px]">
            <div class="container max-w-[1198px]">
                <ArchWithStar />
                <div class="relative px-4 max-w-[400px] mx-auto lg:max-w-[560px] xl:px-0">
                    <h1 class="text-xl leading-none font-Gloock uppercase text-center mb-8 lg:text-5xl lg:leading-none lg:mb-20">
                        {contactPageMeta.title}
                    </h1>
                    <ContentManager
                        items={contactPageMeta.description.nodes}
                        className="text-sm leading-[1.3] tracking-[-0.41px] uppercase text-center text-appGray-700 mb-8 lg:text-base lg:leading-[1.3] lg:mb-12"
                    />
                    {business.mallLocation && (
                        <p class="text-center mb-8 lg:mb-10">
                            <span class="block text-xs leading-none tracking-[-0.41px] uppercase text-appGray-400 mb-2 lg:text-sm lg:leading-none">
                                Centro Comercial Plaza Central
                            </span>
                            <span class="font-Gloock text-lg leading-tight lg:text-2xl">
                                {business.mallLocation}
                            </span>
                        </p>
                    )}
                    <div class="bg-[#E5E4DA] rounded-2xl p-4 mb-8 lg:mb-10">
                        <iframe
                            src={mapEmbedUrl}
                            title="Mapa: Centro Comercial Plaza Central, Bogotá"
                            loading="lazy"
                            referrerpolicy="no-referrer-when-downgrade"
                            class="block w-full aspect-[4/3] border-0 rounded-[10px]"
                        ></iframe>
                    </div>
                    <Btn
                        to={business.maps.url}
                        className="uppercase max-w-max mx-auto"
                    >
                        <span>Abrir mapa</span>
                    </Btn>
                </div>
            </div>
        </section>
    </div>
</Layout>
