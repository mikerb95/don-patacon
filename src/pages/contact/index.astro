---
import ArchWithStar from "../../components/ArchWithStar";
import Prose from "../../components/Prose";
import Layout from "../../layouts/Layout.astro";
import Btn from "../../components/Btn";
import { business, pages } from '../../lib/content';
import { summarizeHours } from '../../lib/hours';
import { MALL_EMBED_URL } from '../../lib/maps';

const contact = pages.contact;
const hours = summarizeHours(business.hours);
const mapEmbedUrl = MALL_EMBED_URL;
---

<Layout
    title={`${contact.title} - DON PATACÓN`}
    description="Cómo llegar a DON PATACÓN en el Centro Comercial Plaza Central, Bogotá: dirección, mapa, teléfono y horario."
>
    <div>
        <section class="pt-[108px] pb-10 overflow-hidden md:pb-20 lg:pt-[218px] lg:pb-[120px]">
            <div class="container max-w-[1198px]">
                <ArchWithStar />
                <div class="relative px-4 max-w-[400px] mx-auto lg:max-w-[560px] xl:px-0">
                    <h1 class="text-xl leading-none font-Gloock uppercase text-center mb-8 lg:text-5xl lg:leading-none lg:mb-20">
                        {contact.title}
                    </h1>
                    <Prose
                        text={contact.description}
                        className="text-sm leading-[1.3] tracking-[-0.41px] uppercase text-center text-appGray-700 mb-8 lg:text-base lg:leading-[1.3] lg:mb-12"
                    />
                    {business.mallLocation && (
                        <p class="text-center mb-8 lg:mb-10">
                            <span class="block text-xs leading-none tracking-[-0.41px] uppercase text-appGray-400 mb-2 lg:text-sm lg:leading-none">
                                Centro Comercial Plaza Central
                            </span>
                            <span class="font-Gloock text-lg leading-tight lg:text-2xl">
                                {business.mallLocation}
                            </span>
                        </p>
                    )}
                    {hours.length > 0 && (
                        <ul class="text-sm leading-[1.5] text-center text-appGray-700 mb-8 lg:text-base lg:mb-10">
                            {hours.map((line) => <li>{line}</li>)}
                        </ul>
                    )}
                    <div class="bg-[#E5E4DA] rounded-2xl p-4 mb-8 lg:mb-10">
                        <iframe
                            src={mapEmbedUrl}
                            title="Mapa: Centro Comercial Plaza Central, Bogotá"
                            loading="lazy"
                            referrerpolicy="no-referrer-when-downgrade"
                            class="block w-full aspect-[4/3] border-0 rounded-[10px]"
                        ></iframe>
                    </div>
                    {contact.howToArrive && (
                        <div class="mb-8 lg:mb-10">
                            <h2 class="font-Gloock text-lg leading-tight text-center mb-3 lg:text-2xl">Cómo llegar</h2>
                            <Prose text={contact.howToArrive} className="text-sm leading-[1.4] text-center text-appGray-700 lg:text-base" />
                        </div>
                    )}
                    <Btn
                        to={business.mapsUrl}
                        className="uppercase max-w-max mx-auto"
                    >
                        <span>Abrir mapa</span>
                    </Btn>
                </div>
            </div>
        </section>
    </div>
</Layout>
