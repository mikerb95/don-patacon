---
import HojasDecor from "../components/HojasDecor";
import Prose from "../components/Prose";
import Layout from "../layouts/Layout.astro";
import Btn from "../components/Btn";
import type { Docs } from '../lib/schema';
import { summarizeHours } from '../lib/hours';
import { MALL_EMBED_URL, mapsLink } from '../lib/maps';

interface Props {
    content: Docs;
    preview?: boolean;
}

const { content, preview } = Astro.props;
const { business, pages } = content;

const contact = pages.contact;
const hours = summarizeHours(business.hours);
const mapEmbedUrl = MALL_EMBED_URL;
const mapsUrl = mapsLink(business);
---

<Layout
    content={content}
    preview={preview}
    title={`${contact.title} - Don Patacón`}
    description="Cómo llegar a Don Patacón en el Centro Comercial Plaza Central, Bogotá: dirección, mapa, teléfono y horario."
>
    <div>
        <section class="relative pt-16 pb-20 lg:pt-24 lg:pb-28">
            <div class="container max-w-[1198px]">
                <HojasDecor />
                <div class="relative px-4 max-w-[400px] mx-auto lg:max-w-[560px] xl:px-0">
                    <h1 class="font-display text-[clamp(2.6rem,1.8rem+3vw,4.2rem)] leading-none text-center text-balance [text-shadow:.05em_.05em_0_#F5B41F] mb-8 lg:mb-20">
                        {contact.title}
                    </h1>
                    <Prose
                        text={contact.description}
                        className="text-lg leading-snug text-center text-appGray-700 mb-8  lg:mb-12"
                    />
                    {business.mallLocation && (
                        <p class="text-center mb-8 lg:mb-10">
                            <span class="block font-bold text-hoja mb-1">
                                Centro Comercial Plaza Central
                            </span>
                            <span class="font-display text-2xl leading-tight lg:text-3xl">
                                {business.mallLocation}
                            </span>
                        </p>
                    )}
                    {hours.length > 0 && (
                        <ul class="text-sm leading-[1.5] text-center text-appGray-700 mb-8 lg:text-base lg:mb-10">
                            {hours.map((line) => <li>{line}</li>)}
                        </ul>
                    )}
                    <div class="border-3 border-monte rounded-2xl overflow-hidden shadow-dura mb-8 lg:mb-10">
                        <iframe
                            src={mapEmbedUrl}
                            title="Mapa: Centro Comercial Plaza Central, Bogotá"
                            loading="lazy"
                            referrerpolicy="no-referrer-when-downgrade"
                            class="block w-full aspect-[4/3] border-0"
                        ></iframe>
                    </div>
                    {contact.howToArrive && (
                        <div class="mb-8 lg:mb-10">
                            <h2 class="font-display text-lg leading-tight text-center mb-3 lg:text-2xl">Cómo llegar</h2>
                            <Prose text={contact.howToArrive} className="text-sm leading-[1.4] text-center text-appGray-700 lg:text-base" />
                        </div>
                    )}
                    <div class="flex flex-wrap justify-center gap-3">
                        <Btn to={mapsUrl} theme="accent" external className="max-w-max">
                            Abrir en Google Maps
                        </Btn>
                        {business.reviewsUrl && (
                            <Btn to={business.reviewsUrl} external className="max-w-max">
                                Reseñas en Google
                            </Btn>
                        )}
                    </div>
                </div>
            </div>
        </section>
    </div>
</Layout>
