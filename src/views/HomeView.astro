---
import HomeAmbience from '../components/home-page/Ambience';
import HomeHero from '../components/home-page/Hero';
import HomeMenu from '../components/home-page/Menu';
import HomeSpecials from '../components/home-page/Specials';
import HomeTestimonials from '../components/home-page/Testimonials';
import 'swiper/css';

import Layout from '../layouts/Layout.astro';
import RestaurantJsonLd from '../components/RestaurantJsonLd.astro';
import type { Docs } from '../lib/schema';
import { MALL_EMBED_URL } from '../lib/maps';

interface Props {
    content: Docs;
    preview?: boolean;
}

const { content, preview } = Astro.props;
const { business, menu, pages } = content;

const home = pages.home;
const address = [business.mallLocation, business.address.line1].filter(Boolean).join(', ');
const specials = menu.dishes.filter((d) => d.specialDays.length > 0);

// Numeración de secciones: se saltan las que aún no tienen contenido.
let section = 0;
const next = () => ++section;
---

<Layout
    content={content}
    preview={preview}
    title="DON PATACÓN: cocina colombiana en Plaza Central, Bogotá"
    description="DON PATACÓN, cocina colombiana en el Centro Comercial Plaza Central, Bogotá. Carta, especiales del día y pedidos para recoger o a domicilio."
>
    <RestaurantJsonLd slot="head" business={business} />
    <div>
        <HomeHero
            title={home.heroTitle}
            image={home.heroImage}
            hours={business.hours}
            address={address}
            description={home.heroDescription}
            mapsUrl={business.mapsUrl}
            mapEmbedUrl={MALL_EMBED_URL}
            client:load
        />
        {menu.categories.length > 0 && (
            <HomeMenu
                index={next()}
                title={home.menuTitle}
                description={home.menuDescription}
                categories={menu.categories}
            />
        )}
        {home.ambienceItems.length > 0 && (
            <HomeAmbience
                index={next()}
                title={home.ambienceTitle}
                description={home.ambienceDescription}
                items={home.ambienceItems}
            />
        )}
        {specials.length > 0 && (
            <HomeSpecials
                index={next()}
                title={home.specialsTitle}
                description={home.specialsDescription}
                items={specials}
                client:visible
            />
        )}
        {home.testimonials.length > 0 && (
            <HomeTestimonials
                index={next()}
                title={home.testimonialsTitle}
                description={home.testimonialsDescription}
                testimonials={home.testimonials}
                client:visible
            />
        )}
    </div>
</Layout>
