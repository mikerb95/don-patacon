---
import HomeAmbience from '../components/home-page/Ambience';
import HeroEscena from '../components/home-page/HeroEscena.astro';
import Favoritos from '../components/home-page/Favoritos.astro';
import LlevaloACasa from '../components/home-page/LlevaloACasa.astro';
import ComoLlegar from '../components/home-page/ComoLlegar.astro';
import HomeProcess from '../components/home-page/Process';
import HomeSpecials from '../components/home-page/Specials';
import HomeTestimonials from '../components/home-page/Testimonials';
import 'swiper/css';

import Layout from '../layouts/Layout.astro';
import RestaurantJsonLd from '../components/RestaurantJsonLd.astro';
import type { Docs } from '../lib/schema';
import { mapsLink } from '../lib/maps';

interface Props {
    content: Docs;
    preview?: boolean;
}

const { content, preview } = Astro.props;
const { business, menu, pages } = content;

const home = pages.home;
const available = menu.dishes.filter((d) => d.available);
// Destacados desde el panel; sin ninguno marcado, los primeros de la carta.
const featured = (available.some((d) => d.featured) ? available.filter((d) => d.featured) : available).slice(0, 4);
const mapsUrl = mapsLink(business);
const specials = menu.dishes.filter((d) => d.specialDays.length > 0);

// Numeración de secciones: se saltan las que aún no tienen contenido.
let section = 0;
const next = () => ++section;
---

<Layout
    content={content}
    preview={preview}
    title="Don Patacón: patacones en la plazoleta de Plaza Central, Bogotá"
    description="Don Patacón: patacones crujientes en verde o maduro, en el local 3-48 de la plazoleta de comidas del Centro Comercial Plaza Central, Bogotá."
>
    <RestaurantJsonLd slot="head" business={business} />
    <div>
        <HeroEscena
            title={home.heroTitle}
            description={home.heroDescription}
            image={home.heroImage}
            mallLocation={business.mallLocation}
            hours={business.hours}
        />
        {featured.length > 0 && (
            <Favoritos title={home.menuTitle} description={home.menuDescription} dishes={featured} />
        )}
        {home.processSteps.length > 0 && (
            <HomeProcess
                index={next()}
                title={home.processTitle}
                description={home.processDescription}
                steps={home.processSteps}
            />
        )}
        {home.takeHomeTitle && home.takeHomeDescription && (
            <LlevaloACasa
                title={home.takeHomeTitle}
                description={home.takeHomeDescription}
                image={home.takeHomeImage}
                steps={home.takeHomeSteps.filter(Boolean)}
                note={home.takeHomeNote}
            />
        )}
        {home.ambienceItems.length > 0 && (
            <HomeAmbience
                index={next()}
                title={home.ambienceTitle}
                description={home.ambienceDescription}
                items={home.ambienceItems}
            />
        )}
        {specials.length > 0 && (
            <HomeSpecials
                index={next()}
                title={home.specialsTitle}
                description={home.specialsDescription}
                items={specials}
                client:visible
            />
        )}
        {home.testimonials.length > 0 && (
            <HomeTestimonials
                index={next()}
                title={home.testimonialsTitle}
                description={home.testimonialsDescription}
                testimonials={home.testimonials}
                client:visible
            />
        )}
        {home.visitSteps.length > 0 && (
            <ComoLlegar
                title={home.visitTitle}
                steps={home.visitSteps}
                image={home.visitImage}
                caption={home.visitImageCaption}
                mapsUrl={mapsUrl}
            />
        )}
    </div>
</Layout>
