---
import ArchWithStar from "../components/ArchWithStar";
import Prose from "../components/Prose";
import Layout from "../layouts/Layout.astro";
import type { Docs } from '../lib/schema';

interface Props {
    content: Docs;
    preview?: boolean;
}

const { content, preview } = Astro.props;
const { pages } = content;

const sections = pages.legal.sections;
---

<Layout
    content={content}
    preview={preview}
    title={`Legal - DON PATACÓN`}
    description="Términos, condiciones y política de tratamiento de datos de DON PATACÓN."
>
    <div>
        <section class="pt-[108px] pb-10 overflow-hidden md:pb-20 lg:pt-[218px] lg:pb-[120px]">
            <div class="container max-w-[1198px]">
                <ArchWithStar />
                <div class="relative px-4 max-w-[400px] mx-auto lg:max-w-[850px] xl:px-0">
                    <h1 class="text-xl leading-none font-Gloock uppercase text-center mb-12 lg:text-5xl lg:leading-none lg:mb-20">
                        Legal
                    </h1>
                    {sections.length === 0 && (
                        <p class="text-center text-appGray-700">
                            Consulta nuestra <a class="underline" href="/privacidad">política de tratamiento de datos</a>.
                        </p>
                    )}
                    <div class="grid grid-cols-1 gap-4 w-full max-w-[850px] mx-auto lg:gap-6">
                        {sections.map((item) => (
                            <div
                                class="border border-[#DBD9D5] rounded-[7px] p-6"
                            >
                                <h2 class="leading-none tracking-[-0.41px] font-Gloock mb-[14px] lg:text-[32px] lg:leading-none lg:mb-5">
                                    {item.title}
                                </h2>
                                <Prose
                                    text={item.body}
                                    className="text-sm leading-normal tracking-[-0.41px] text-appGray-200 lg:text-lg lg:leading-normal"
                                />
                            </div>
                        ))}
                    </div>
                </div>
            </div>
        </section>
    </div>
</Layout>
