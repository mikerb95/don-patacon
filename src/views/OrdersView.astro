---
import OrderForm from "../components/order-page/Form";
import Layout from "../layouts/Layout.astro";
import type { Docs } from '../lib/schema';

interface Props {
    content: Docs;
    preview?: boolean;
}

const { content, preview } = Astro.props;
const { business, menu } = content;
const plantainChoice = menu.dishes.some((d) => d.plantainChoice && d.available);
---

<Layout
    content={content}
    preview={preview}
    whatsappButton={false}
    title={`Pedidos - Don Patacón`}
    description="Pide en Don Patacón por WhatsApp y recoge en el Centro Comercial Plaza Central, Bogotá, o pide a domicilio."
>
    <div>
        <OrderForm
            businessName={business.name}
            whatsappNumber={business.whatsapp}
            mallLocation={business.mallLocation}
            delivery={business.delivery}
            plantainChoice={plantainChoice}
            client:load
        />
    </div>
</Layout>
